{
  "url": "{{parameters.baseUrl}}/customer_api/v1/instances/{{parameters.instanceId}}/users/make-connection-check",
  "method": "DELETE",
  "headers": {
    "Authorization": "Bearer {{parameters.primaryKey}}"
  },
  "response": {
    "error": {
      "message": "[{{statusCode}}] {{ifempty(body.description, ifempty(body.error, 'Check the instance ID and secret key.'))}}"
    }
  },
  "log": {
    "sanitize": ["request.headers.authorization"]
  }
}
