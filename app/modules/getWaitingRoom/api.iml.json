{
  "temp": {
    "ts": "{{formatDate(now, 'X')}}"
  },
  "url": "/apps/{{connection.appId}}/waiting_rooms/{{parameters.room}}",
  "method": "GET",
  "qs": {
    "auth_key": "{{connection.key}}",
    "auth_timestamp": "{{temp.ts}}",
    "auth_version": "1.0",
    "auth_signature": "{{sha256('GET\n/apps/' + connection.appId + '/waiting_rooms/' + parameters.room + '\nauth_key=' + connection.key + '&auth_timestamp=' + temp.ts + '&auth_version=1.0', 'hex', connection.secret)}}"
  },
  "response": {
    "output": {
      "room": "{{body.room}}",
      "title": "{{body.title}}",
      "state": "{{body.state}}",
      "waiting": "{{body.waiting}}",
      "admitted": "{{body.admitted}}",
      "issued": "{{body.issued}}",
      "admitPerMinute": "{{body.admit_per_minute}}",
      "startsAt": "{{body.starts_at}}",
      "burst": "{{body.burst}}",
      "passTtlSeconds": "{{body.pass_ttl_seconds}}",
      "returnUrls": "{{body.return_urls}}",
      "channel": "{{body.channel}}"
    }
  }
}
