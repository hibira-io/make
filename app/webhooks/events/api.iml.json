{
  "iterate": "{{body.events}}",
  "output": {
    "name": "{{item.name}}",
    "channel": "{{item.channel}}",
    "userId": "{{item.user_id}}",
    "event": "{{item.event}}",
    "data": "{{item.data}}",
    "socketId": "{{item.socket_id}}",
    "subscriptionCount": "{{item.subscription_count}}",
    "time": "{{parseDate(body.time_ms, 'x')}}"
  },
  "respond": {
    "status": 200,
    "body": { "ok": true }
  }
}
